#to count vowels:aeiou and consonants

n=input()
s=0
for i in n:
    s+=1
vowels=0
consonants=0
for i in range(0,s):
    if n[i]=='a' or n[i]=='e' or n[i]=='i' or n[i]=='o' or n[i]=='u' or n[i]=='A' or n=='E' or n[i]=='I' or n[i]=='O' or n[i]=='U':
        vowels+=1
    else:
        consonants+=1
print("Vowels: ",vowels)
print("Consonants: ",consonants)