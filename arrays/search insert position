#program to search insert position

nums=list(map(int,input().split()))
target=int(input())
left=0
right=len(nums)-1
while left<=right:
    mid=(left+right)//2
    if nums[mid]==target:
        print(mid)
        break
    elif nums[mid]<target:
        left=mid+1
        break
    else:
        right=mid-1
        break
print(left)