#to find the second largest element

n=int(input())
a=list(map(int,input().split()))
largest=a[0]
second_largest=-99999
for i in range(n):
    if a[i]>largest:
        second_largest=largest
        largest=a[i]
    elif a[i]>second_largest and a[i]!=largest:
        second_largest=a[i]
print(second_largest)