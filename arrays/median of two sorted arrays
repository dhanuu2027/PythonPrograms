#to find the median of two sorted arrays

nums1=list(map(int,input().split()))
nums2=list(map(int,input().split()))
c=nums1+nums2
for i in range(len(c)):
    for j in range(i+1,len(c)):
        if c[i]>c[j]:
            c[i],c[j]=c[j],c[i]
n=len(c)
if n%2==1:
    print(float(c[n//2]))
else:
    print(float(c[n//2-1]+[n//2]))/2