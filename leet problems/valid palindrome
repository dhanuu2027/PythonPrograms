s=input()
n=len(s)
r=""
for i in range(n):
    if s[i]>='A' and s[i]<='Z':
        r+=chr(ord(s[i])+32)
    else:
        r+=chr(ord(s[i]))
result=""
for i in range(n):
    if r[i]>='a' and r[i]<='z' or r[i]>='0' and r[i]<='9':
        result+=r[i]
left=0
right=len(result)-1
found=1
for i in range(len(result)):
    if result[left]!=result[right]:
        found=0
        break
    left+=1
    right-=1
if found==0:
    print("False")
else:
    print("True")